# .gitignore  [What Git must never track]
# Purpose: keep data, secrets and generated files out of GitHub
# Kept as real rules on purpose: a missing rule can leak personal data or secrets

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Environments and secrets
.env
.env.*
!.env.example
.venv/
env/
venv/

# Tooling
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# OS and IDE
.DS_Store
.idea/
.vscode/*
!.vscode/settings.json

# Data: never in Git by default (it may hold personal or confidential information).
# Only the DVC pointers (*.dvc) are committed; the files they point to live on DagsHub (dvc pull).
# Written as files-then-exceptions, not data/**, because DVC reads .gitignore too and skips
# pointers hidden by data/**, so dvc pull would not download the input data
data/**/*
!data/**/
!data/**/*.dvc

# Generated outputs (recreated by: python -m src.main)
models/**
!models/
reports/**
!reports/
!reports/README.md

# Pipeline outputs and logs, named explicitly (the folder rules above already cover the first three)
data/processed/*.csv
models/*.joblib
reports/*.csv
logs/

# Local files written by W&B on every run (the run itself lives in W&B)
wandb/
