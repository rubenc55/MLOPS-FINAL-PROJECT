# .env.example  [Secret names, no secret values]
# -------------------------------------------------------------------
# Purpose   Tell teammates WHICH secrets the project needs, without sharing them
# How       Copy to .env and fill in real values. .env is in .gitignore, this file is committed
# Read by   main.py and api.py at startup (stage 3)

# MLflow on DagsHub (tracking and model registry): your DagsHub user and a DagsHub token
# (dagshub.com > Your Settings > Tokens). Read by main.py and scripts/fetch_prod_model.py through load_dotenv.
# Without them the pipeline still runs, with tracking disabled. In CI they come from the GitHub Secrets
# DAGSHUB_USER and DAGSHUB_TOKEN
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
